# OpenMetadata Agent Bot: MCP/native metadata access and confirmed tag mutation.
OPENMETADATA_MCP_URL=http://localhost:8585/mcp
OPENMETADATA_BASE_URL=http://localhost:8585
OPENMETADATA_AGENT_BOT_TOKEN=replace-with-agent-bot-token

# Frozen R5 Backend FastMCP.
BACKEND_MCP_URL=http://127.0.0.1:8001/mcp
GOVERNANCE_ENVIRONMENT=local

# Shared lab Redis broker. Host-local Agent uses 127.0.0.1; Dockerized Agent can override to redis.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# 9router OpenAI-compatible LLM endpoint. Obtain the exact URL and model ID
# from the tenant configuration; never commit a real key.
LLM_BASE_URL=https://replace-with-9router-endpoint/v1
LLM_API_KEY=replace-with-9router-machine-key
LLM_MODEL=replace-with-9router-model-id
