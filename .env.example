# OpenMetadata Agent Bot: read-only MCP retrieval and native Suggestion creation.
OPENMETADATA_MCP_URL=http://localhost:8585/mcp
OPENMETADATA_BASE_URL=http://localhost:8585
OPENMETADATA_AGENT_BOT_TOKEN=replace-with-agent-bot-token

# 9router OpenAI-compatible LLM endpoint. Obtain the exact URL and model ID
# from the 9router tenant configuration; never commit a real key.
LLM_BASE_URL=https://replace-with-9router-endpoint/v1
LLM_API_KEY=replace-with-9router-machine-key
LLM_MODEL=replace-with-9router-model-id
